      "view/item/context": [
        {
          "command": "govkb.openPromotion",
          "when": "view == govkb.promotions && (viewItem == govkb.promotion || viewItem == govkb.promotion.ready || viewItem == govkb.promotion.accepted || viewItem == govkb.promotion.applied)",
          "group": "inline@1"
        },
        {
          "command": "govkb.openPromotionWorktree",
          "when": "view == govkb.promotions && (viewItem == govkb.promotion || viewItem == govkb.promotion.ready || viewItem == govkb.promotion.accepted || viewItem == govkb.promotion.applied)",
          "group": "navigation@9"
        },
        {
          "command": "govkb.showPromotion",
          "when": "view == govkb.promotions && (viewItem == govkb.promotion || viewItem == govkb.promotion.ready || viewItem == govkb.promotion.accepted || viewItem == govkb.promotion.applied)",
          "group": "inline@2"
        },
        {
          "command": "govkb.finalizeAcceptedPromotion",
          "when": "view == govkb.promotions && viewItem == govkb.promotion.accepted",
          "group": "navigation@1"
        },
        {
          "command": "govkb.markPromotionAccepted",
          "when": "view == govkb.promotions && viewItem == govkb.promotion.ready",
          "group": "navigation@2"
        },
        {
          "command": "govkb.markPromotionRejected",
          "when": "view == govkb.promotions && viewItem == govkb.promotion.ready",
          "group": "navigation@3"
        },
        {
          "command": "govkb.archivePromotion",
          "when": "view == govkb.promotions && (viewItem == govkb.promotion || viewItem == govkb.promotion.accepted || viewItem == govkb.promotion.applied)",
          "group": "navigation@4"
        },
        {
          "command": "govkb.openCandidate",
          "when": "view == govkb.candidates && viewItem == govkb.candidate",
          "group": "inline@1"
        },
        {
          "command": "govkb.openCapability",
          "when": "view == govkb.capabilities && viewItem == govkb.capability",
          "group": "inline@1"
        },
        {
          "command": "govkb.renameGovernedSkill",
          "when": "view == govkb.capabilities && viewItem == govkb.capability",
          "group": "navigation@1"
        },
        {
          "command": "govkb.mergeGovernedSkills",
          "when": "view == govkb.capabilities && viewItem == govkb.capability",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "GovKB",
      "properties": {
        "govkb.command": {
          "type": "string",
          "default": "govkb",
          "description": "GovKB runtime command. Use govkb for a PATH launcher, an absolute executable path, or python-module to run Python module mode."
        },
        "govkb.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python executable used only when GovKB: Command is python-module; it must be able to import govkb.cli."
        },
        "govkb.setupMode": {
          "type": "string",
          "default": "guidedInstall",
          "enum": [
            "auto",
            "useExisting",
            "guidedInstall"
          ],
          "description": "How local setup explains a missing runtime. guidedInstall shows setup guidance; useExisting assumes you manage the runtime command yourself."
        },
        "govkb.codexHome": {
          "type": "string",
          "default": "",
          "description": "Optional CODEX_HOME override used by setup, apply, status, reports, and memory review."
        },
        "govkb.classifierModel": {
          "type": "string",
          "default": "",
          "description": "Optional memory-review classifier model override. Leave empty to use the GovKB CLI default or GOVKB_CODEX_MODEL."
        },
        "govkb.classifierReasoning": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "description": "Optional memory-review classifier reasoning override. Leave empty to use the GovKB CLI default or GOVKB_CODEX_REASONING."
        },
        "govkb.reviewTimeoutSeconds": {
          "type": "number",
          "default": 180,
          "description": "Classifier timeout in seconds for GovKB memory review. Use 0 to let the GovKB CLI default apply."
        },
        "govkb.reviewLookbackDays": {
          "type": "number",
          "default": 90,
          "description": "Lookback window in days for GovKB learning discovery and bounded memory review."
        },
        "govkb.reviewMaxSessions": {
          "type": "number",
          "default": 5,
          "description": "Maximum recent Codex sessions scanned by GovKB learning review in one batch."
        },
        "govkb.defaultDryRun": {
          "type": "boolean",
          "default": true,
          "description": "Default memory-review mode."
        },
        "govkb.autoRefreshOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh read-only GovKB status, reports, and promotions for the remembered project when the workspace opens."
        },
        "govkb.monitorIntervalSeconds": {
          "type": "number",
          "default": 0,
          "description": "Optional read-only refresh interval for status, reports, candidates, and promotions. Use 0 to disable periodic monitoring; minimum active interval is 30 seconds."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "govkb",
