def resolve_codex_home() -> Path:
    configured = os.environ.get("CODEX_HOME", "").strip()
    if configured:
        return Path(configured).expanduser()

    script_path = Path(__file__).expanduser()
    installed_home = script_path.parent.parent
    if script_path.parent.name == "bin" and (
        (installed_home / "skills").exists() or (installed_home / "memories").exists()
    ):
        return installed_home

    return Path.home() / ".codex"


