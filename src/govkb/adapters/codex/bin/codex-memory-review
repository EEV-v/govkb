    "with",
}


@dataclass(frozen=True)
class SessionRef:
    id: str
    thread_name: str
    updated_at: str
    path: Path
    indexed: bool


@dataclass(frozen=True)
class MemoryTarget:
    skill: str
    capability_id: str
    project_id: str | None
    path: Path
    requires_explicit_acceptance: bool
    headings: tuple[str, ...]
    content: str
    aliases: tuple[str, ...]
    hints: tuple[str, ...]
    negative_hints: tuple[str, ...]
    project_root: Path | None


@dataclass(frozen=True)
class DiscoveryStats:
    indexed_rows: int
    indexed_missing_files: int
    file_only_recent_unprocessed: int
    selected_indexed: int
    selected_file_only: int


@dataclass(frozen=True)
class SessionSignals:
    user_text: str
    assistant_text: str
    task_complete_text: str
    explicit_skills: tuple[str, ...]
    hinted_skills: tuple[str, ...]
    generic_relevance: bool
    self_referential: bool


@dataclass(frozen=True)
class SessionEvidence:
    user_ask: str
    final_outcome: str
    changed_files: tuple[str, ...]
    successful_commands: tuple[str, ...]
    failed_commands: tuple[str, ...]
    artifact_paths: tuple[str, ...]


class RetryableClassificationError(RuntimeError):
    """Classifier failure that should be retried later."""


class UsageLimitClassificationError(RetryableClassificationError):
    """Classifier failed because the nested Codex account is quota-limited."""


class ConnectivityClassificationError(RetryableClassificationError):
    """Classifier failed because the nested Codex transport is unavailable."""


