#!/usr/bin/env python3
"""Review recent Codex sessions and maintain skill long-term memory.

The model proposes memory candidates; this script decides whether any proposal is
safe to apply. Ambiguous or approval-gated candidates are staged as patches.
"""

from __future__ import annotations

